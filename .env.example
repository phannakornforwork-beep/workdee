# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้ามอัปโหลด .env.local ขึ้น GitHub)

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# ใช้ publishable key (sb_publishable_...) หรือ anon key แบบเดิมก็ได้
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ใช้ secret key (sb_secret_...) หรือ service_role key แบบเดิม เก็บเป็นความลับ ใช้เฉพาะฝั่งเซิร์ฟเวอร์
SUPABASE_SECRET_KEY=

# ที่อยู่เว็บจริง เช่น https://workdee.vercel.app (ใช้สร้างลิงก์ในอีเมลและ LINE)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# รหัสลับสำหรับงานตามเวลา (Vercel Cron ส่งมาใน header Authorization)
CRON_SECRET=

# อีเมลแจ้งเตือนผ่าน Resend (ไม่ใส่ = ไม่ส่งอีเมล)
RESEND_API_KEY=
EMAIL_FROM=WorkDee <no-reply@your-domain.com>

# LINE Official Account → LINE Developers → Messaging API (ไม่ใส่ = ไม่ส่ง LINE)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@your-oa-id

# อีเมลติดต่อทีมงาน แสดงในหน้าช่วยเหลือ นโยบายความเป็นส่วนตัว และเงื่อนไขการใช้งาน
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com

# ชื่อและที่อยู่ผู้ให้บริการ (ผู้ควบคุมข้อมูลส่วนบุคคลตาม PDPA) แสดงในนโยบายความเป็นส่วนตัวและเงื่อนไขการใช้งาน
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=

# ตั้งเป็น 1 หลังเปิด Google provider ใน Supabase (docs/SETUP.md ขั้นที่ 3.5)
NEXT_PUBLIC_AUTH_GOOGLE=
